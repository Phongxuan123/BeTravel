{
  "name": "betravel-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable authentication backend for BeTravel",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\"",
    "test": "node --test \"test/**/*.test.js\"",
    "test:golden": "node --test test/golden.test.js",
    "create-admin": "node scripts/create-admin.js",
    "seed": "node scripts/seed-content.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.5",
    "nodemailer": "^10.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2"
  }
}
