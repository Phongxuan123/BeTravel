NODE_ENV=development
PORT=3000

# Chỉ quan trọng với client chạy trên trình duyệt (admin web).
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# MongoDB Atlas bắt buộc, kể cả dev -- MongoDB local không có Vector Search.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/WDPPROJECT01
MONGO_MAX_POOL_SIZE=10

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES=15m
REFRESH_TTL_DAYS=30

# body = mobile (expo-secure-store) · cookie = admin web · both = cả hai.
AUTH_TRANSPORT=body
# Refresh token vừa bị thay bằng token mới vẫn được chấp nhận trong N giây --
# xử lý race hai request /refresh đến gần như đồng thời mà không mất xoay vòng.
REFRESH_ROTATION_GRACE_SECONDS=10

GOOGLE_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com

# Chỉ cần cho luồng quên mật khẩu.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
# true = khong gui email that (dev khong co SMTP). Production de false.
SMTP_DISABLED=false

# ── RAG / AI (dùng từ B4 trở đi, khai báo sẵn ở đây để env.js validate được) ──
# Nhom thong nhat dung APIZ (dich vu tuong thich OpenAI): LLM_PROVIDER=openai + OPENAI_API_KEY cua APIZ.
# mock: không gọi API thật, dùng cho test và CI -- không tốn quota.
LLM_PROVIDER=openai
GEMINI_API_KEY=
OPENAI_API_KEY=
# APIZ khong ho tro response_format json_object nen OPENAI_JSON_MODE=false.
OPENAI_BASE_URL=https://api.apiz.vn/v1
OPENAI_JSON_MODE=false
# hybrid = vector + tu khoa (can EMBEDDING_PROVIDER that); lexical = chi tu khoa, khong goi embedding,
# cau hoi duoc LLM chuyen thanh tu khoa. lexical chi chay voi SEARCH_DRIVER=memory.
RETRIEVAL_MODE=lexical
# Nguong diem phu tu khoa (0-1) cho che do lexical.
RAG_MIN_KEYWORD_TOP_SCORE=0.4
RAG_MIN_KEYWORD_SOFT_SCORE=0.3
# Model rieng cho buoc tao tu khoa (che do lexical); rong = dung LLM_MODEL.
# glm-5.3-flash hay het gio 15s va bo qua system prompt (kiem 27/10/2026); gpt-6-luna do 3-6s, JSON dung.
QUERY_REWRITE_MODEL=gpt-6-luna
# Model du phong cho cac buoc phu khi model chinh het gio/tra JSON hong (rong = tat).
QUERY_REWRITE_FALLBACK_MODEL=
LLM_MODEL=gpt-6.1-sol
# Che do lexical khong goi embedding nen de mock.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# atlas: dùng 2 Atlas Search index thật · memory: cosine similarity trong RAM,
# chạy được khi mất mạng, khi CI, hoặc khi Atlas index chưa sẵn sàng.
SEARCH_DRIVER=memory
VECTOR_INDEX_NAME=vec_idx
TEXT_INDEX_NAME=txt_idx
# Tam phong toa tra cuu phap luat (cam nang, tim kiem, AI Legal). false = cac API
# /api/legal/* tra FORBIDDEN (reason FEATURE_DISABLED). Bat lai: true.
LEGAL_LOOKUP_ENABLED=true
# Chi dung khi LLM_PROVIDER=gemini. Voi openai/APIZ, dich dung LLM_MODEL.
TRANSLATION_MODEL=gemini-3.5-flash-lite
# gemini | claude: dich luat Uc bang nha cung cap do (can GEMINI_API_KEY / ANTHROPIC_API_KEY) du chat dung APIZ; default: dung chung voi chat.
# Voi claude, dat TRANSLATION_MODEL=claude-haiku-5-5.
TRANSLATION_PROVIDER=default
# Chi can khi TRANSLATION_PROVIDER=claude.
ANTHROPIC_API_KEY=
RAG_TOP_K=8
RAG_NUM_CANDIDATES=150
RAG_MIN_TOP_SCORE=0.62
RAG_MIN_SOFT_SCORE=0.55
RAG_MIN_CHUNKS=2
AI_DAILY_QUOTA_USER=40
AI_DAILY_QUOTA_GLOBAL=800

# Tro ly AI ban 2 (docs/AI_V2_PLAN.md). ASSISTANT_ENABLED=false la cong tac tat nhanh.
ASSISTANT_ENABLED=true
# Rong = LLM_MODEL / QUERY_REWRITE_MODEL
ASSISTANT_MODEL=
ASSISTANT_TRIAGE_MODEL=
ASSISTANT_TIMEOUT_MS=25000
ASSISTANT_MAX_OUTPUT_TOKENS=700
ASSISTANT_WORD_LIMIT=120
ASSISTANT_DETAILED_WORD_LIMIT=250
ASSISTANT_HISTORY_TURNS=6
ASSISTANT_HISTORY_TTL_DAYS=90
# Tang tra web: Responses API + web_search (APIZ ho tro, /chat/completions thi khong)
ASSISTANT_WEB_SEARCH_ENABLED=false
ASSISTANT_WEB_SEARCH_MODEL=
ASSISTANT_WEB_TIMEOUT_MS=15000
ASSISTANT_WEB_DOMAINS=gov.au
# Cong tac Admin (luu DB) duoc nho trong RAM toi da N ms; Admin doi thi tien trinh do xoa cache ngay
ASSISTANT_SETTINGS_CACHE_MS=10000
# Gia uoc tinh VND / 1 trieu token de ghi chi phi vao ai_events (bieu do Admin). 0 = chua cau hinh.
# Vi du gpt-6-luna qua APIZ (02/11/2026): 1200 / 7200
ASSISTANT_PRICE_INPUT_VND_PER_M=0
ASSISTANT_PRICE_OUTPUT_VND_PER_M=0

# Hiển thị ở GET /api/health.
APP_VERSION=1.0.0

# Timeout mỗi request tới LLM/embedding, không để worker treo vô hạn. APIZ cham hon nen de 60 giay.
AI_PROVIDER_TIMEOUT_MS=60000

# Chỉ dùng bởi `npm run seed` để tạo tài khoản admin đầu tiên. Tự đặt mật khẩu
# mạnh (không có giá trị mặc định); để trống thì seed bỏ qua bước tạo admin.
# Đổi mật khẩu ngay sau khi đăng nhập lần đầu, đặc biệt ở môi trường đã triển khai.
SEED_ADMIN_EMAIL=admin@betravel.local
SEED_ADMIN_PASSWORD=

# Dia diem bo sung (CHUA xac minh, tach khoi diem admin da xac minh). Chon nguon bang PLACES_PROVIDER:
#   osm     = OpenStreetMap qua Overpass, MIEN PHI, khong can key (khuyen dung)
#   serpapi = Google Maps qua SerpApi, tra phi theo luot, can SERPAPI_KEY
#   mock    = du lieu mau, khong goi mang (mac dinh, dung cho test/CI)
PLACES_PROVIDER=osm
# Chi can khi PLACES_PROVIDER=serpapi. KHONG commit key that.
SERPAPI_KEY=
# Chi dung khi PLACES_PROVIDER=osm. Overpass cong cong co the cham/504; co the tro ve may chu rieng.
PLACES_OVERPASS_URL=https://overpass-api.de/api/interpreter
# May chu Overpass DU PHONG (cach nhau bang dau phay), thu lan luot khi may chu chinh qua tai (502/429) hoac treo.
PLACES_OVERPASS_FALLBACK_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Tim dia diem theo chu (Nominatim cua OpenStreetMap, mien phi, can PLACES_USER_AGENT nhan dien duoc).
GEOCODE_URL=https://nominatim.openstreetmap.org
GEOCODE_TIMEOUT_MS=10000
GEOCODE_CACHE_TTL_MINUTES=1440
GEOCODE_DAILY_LIMIT=1500
# Overpass yeu cau User-Agent nhan dien duoc ung dung.
PLACES_USER_AGENT=BeTravel/1.0
PLACES_CACHE_TTL_MINUTES=1440
PLACES_DAILY_LIMIT=100
PLACES_TIMEOUT_MS=20000

# Luat lien bang Uc (Federal Register of Legislation). API cong khai, KHONG can key.
# Chi phu luat Commonwealth, KHONG gom luat cua cac bang/vung lanh tho.
AU_LEGISLATION_API_URL=https://api.prod.legislation.gov.au/v1
AU_LEGISLATION_SITE_URL=https://www.legislation.gov.au
AU_LEGISLATION_USER_AGENT=BeTravel/1.0
AU_LEGISLATION_TIMEOUT_MS=15000
AU_LEGISLATION_CONTENT_TIMEOUT_MS=60000
AU_LEGISLATION_CACHE_TTL_MINUTES=60
# RAG dung ma ban hien hanh tra thanh cong gan nhat (toi da so gio nay) khi nguon luat Uc cham/loi.
AU_REGISTER_MAX_STALE_HOURS=24
# SEARCH_DRIVER=memory: han cache chunk trong RAM (ms); het han thi nap lai o nen, van dung ban cu.
MEMORY_SEARCH_CACHE_TTL_MS=600000
# Thoi gian toi da cho nguon luat Uc xac minh mot luat chua co ket qua con han (qua han: loai chunk, tra tiep o nen).
AU_REGISTER_LOOKUP_BUDGET_MS=5000
# Tran thoi gian buoc tao tu khoa (lexical); qua han thi dung cau hoi goc lam tu khoa.
QUERY_REWRITE_TIMEOUT_MS=15000
# Tu sinh tom tat tung Phan (nhieu luot goi AI) khi co nguoi mo luat lan dau. Mac dinh false de khong dot han muc AI;
# sinh chu dong bang `npm run summarize-au-laws`. Dich theo yeu cau dung TRANSLATION_MODEL (khong dung model chat).
AU_LAW_DEEP_SUMMARY_AUTOGEN=false
# AI dich ten cac luat Uc ngoai danh sach tuyen chon (mot luot goi nho moi trang danh sach, cache DB). 31 luat tuyen chon
# luon co ten tieng Viet viet san. Dat false de khong dung AI cho viec nay.
AU_LAW_TITLE_TRANSLATION=true