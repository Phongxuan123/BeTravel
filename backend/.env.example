# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# MONGODB ATLAS
# ------------------------------------------------------------
# BeTravel uses EXACTLY the database written in this URI.
# There is NO MONGODB_DB_NAME variable and dbName is NOT overridden
# in src/config/db.js.
#
# Keep the real username/password only in your LOCAL .env.
# Never commit .env to Git.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@wdp.w0bnsxm.mongodb.net/WDPPROJECT01

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES=15m

# ------------------------------------------------------------
# GOOGLE LOGIN
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com

# ------------------------------------------------------------
# SMTP
# Registration does NOT use email/OTP.
# SMTP is only needed for forgot-password.
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
