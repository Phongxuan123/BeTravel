NODE_ENV=development
PORT=3000

# Only important for browser-based clients. React Native does not enforce browser CORS.
CLIENT_URL=http://localhost:8081

# MongoDB Atlas. Use the DB name in the URI itself.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/WDPPROJECT01

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES=15m

GOOGLE_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com

# Only needed for forgot-password flow
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
