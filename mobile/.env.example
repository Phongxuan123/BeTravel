# Khi chạy dev (npx expo start), app TỰ suy ra IP host từ chính Metro (hostUri) --
# không cần sửa tay mỗi khi đổi mạng/quán/wifi. Chỉ cần đúng cổng backend:
EXPO_PUBLIC_API_PORT=3000

# EXPO_PUBLIC_API_URL nếu khai báo sẽ được ưu tiên cả dev và production.
# Để trống khi dev muốn tự suy ra IP LAN từ Metro.
# EXPO_PUBLIC_API_URL=https://api.betravel.example.com/api

# true = quay lại dữ liệu giả trong src/mocks/ (đường lùi khi demo lỗi hoặc backend chưa sẵn sàng).
# false = mọi module dùng API thật.
EXPO_PUBLIC_USE_MOCKS=false

# Be.Travel AI dang tam khoa (man cho). true = mo lai man chat that.
EXPO_PUBLIC_AI_CHAT_ENABLED=false

# Bản đồ Android native: bật Maps SDK for Android trong Google Cloud.
# Giới hạn key theo ANDROID_PACKAGE + SHA-1 chứng thư ký; cấu hình quota cap.
# Đặt các biến này trong .env local hoặc EAS environment, rồi build native lại.
# iOS dùng Apple Maps, không cần Maps API key. Expo Go có cấu hình riêng.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
ANDROID_PACKAGE=
IOS_BUNDLE_IDENTIFIER=
