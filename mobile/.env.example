# IMPORTANT:
# Do not use localhost when the app runs inside BlueStacks / Android Emulator.
# Use your Mac's LAN IP, for example:
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api

# Android Studio Emulator can also use:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# true = quay lại dữ liệu giả trong src/mocks/ (đường lùi khi demo lỗi hoặc backend chưa sẵn sàng).
# false = dùng API thật. Batch B1 mới nối auth; nội dung vẫn 100% mock tới B3.
EXPO_PUBLIC_USE_MOCKS=false
