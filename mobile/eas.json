{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://betravel-backend.onrender.com/api",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_ASSISTANT_ENABLED": "true",
        "EXPO_PUBLIC_MAP_TILES": "osm",
        "EXPO_PUBLIC_MAP_REFERER": "https://betravel-admin.vercel.app"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://betravel-backend.onrender.com/api",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_ASSISTANT_ENABLED": "true",
        "EXPO_PUBLIC_MAP_TILES": "osm",
        "EXPO_PUBLIC_MAP_REFERER": "https://betravel-admin.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
