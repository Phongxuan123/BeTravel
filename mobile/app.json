{
  "expo": {
    "name": "Be.Travel",
    "slug": "FE",
    "version": "1.0.0",
    "scheme": "betravel",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.betravel.app"
    },
    "android": {
      "package": "com.betravel.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Be.Travel dùng micro khi bạn bấm nói để chuyển giọng nói thành văn bản. Ứng dụng không lưu file ghi âm.",
          "speechRecognitionPermission": "Be.Travel dùng dịch vụ nhận giọng nói của thiết bị để nhập câu dịch. Dịch vụ có thể xử lý âm thanh qua mạng."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Be.Travel dùng vị trí để tìm hỗ trợ gần bạn, cảnh báo khu vực hoặc chia sẻ vị trí một lần khi bạn chủ động chọn người nhận."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "ec0bf940-013e-4f30-9820-2ad9519f1b17"
      }
    },
    "owner": "xuanphong123"
  }
}
